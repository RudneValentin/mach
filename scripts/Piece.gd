func dim():# dim функция прозрачности
	var sprite = get_node("Sprite") # значение по изменению прозрачности, берет спрайт и изменяет его прозрачность Get_node дает нам доступ к спрайтам. В ковычках указываем к чкму хотим получить доступ Sprite
	sprite.modulate = Color(1, 1, 1, .5);

